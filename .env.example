# Chibi environment example
# Copy this file to .env and fill in the required values.
# For the full configuration template, run `chibi config`.

# Telegram (required)
TELEGRAM_BOT_TOKEN=
USERS_WHITELIST=

# At least one LLM provider (required for private mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
MISTRALAI_API_KEY=
ALIBABA_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MOONSHOTAI_API_KEY=
ZHIPUAI_API_KEY=
OPENROUTER_API_KEY=

# ============================================================================
# GPT / LLM behavior settings
# ============================================================================

# Sampling temperature (0.0-2.0, default: 1.0)
TEMPERATURE=1.0

# Maximum tokens in a single LLM response (default: 32000)
MAX_TOKENS=32000

# Maximum age of conversation history in minutes before cleanup (default: 360)
MAX_CONVERSATION_AGE_MINUTES=360

# Threshold (in tokens) of the real provider-reported prompt size at which the
# conversation is auto-summarized proactively (default: 100000)
MAX_HISTORY_TOKENS=100000

# Automatically summarize and retry once when a provider reports context overflow.
# This reactive safety net complements the proactive MAX_HISTORY_TOKENS threshold. (default: true)
REACTIVE_CONTEXT_RECOVERY=true
